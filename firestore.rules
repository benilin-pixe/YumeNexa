rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'benilin76@gmail.com' ||
        (request.auth.token != null && 'admin' in request.auth.token && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.token.email)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles (with privilege escalation protection)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId && (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'user' ||
          isAdmin()
        )
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.role
        )) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Admin Roles collection
    match /adminRoles/{roleId} {
      allow read, write: if isAdmin();
    }

    // Admin Audit Logs (Immutable once written)
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Error Logs (Client error capture allowed, read/manage restricted to admin)
    match /errorLogs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Site Stats & Analytics (Client pageview counter increment allowed, read/manage restricted to admin)
    match /siteStats/{statId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // Performance & Web Vitals
    match /performanceLogs/{perfId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Site Settings (Maintenance mode, banner config, feature flags)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Configuration & Featured Content
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Health & Diagnostics
    match /systemHealth/{healthId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Provider Health
    match /providerHealth/{providerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Playback Metrics
    match /playbackMetrics/{metricId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Watchlists
    match /watchlists/{watchlistId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Watch History
    match /watchHistory/{historyId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Public Broadcast Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News Cache Articles
    match /news/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    // News Sources Health & Status
    match /news_sources/{sourceId} {
      allow read: if true;
      allow write: if true;
    }

    // News Cache Metadata (e.g. news_meta/cache)
    match /news_meta/{metaId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
